# CDEK API credentials and sender location
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_API_URL=https://api.edu.cdek.ru
CDEK_SENDER_CITY=ст. Брюховецкая, Краснодарский край
CDEK_DEVELOPER_KEY=

# YooKassa shop credentials
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# manual = register NPD receipt in My Tax after payment (recommended for self-employed)
# external = pass receipt JSON to an externally connected fiscal service; configure only if valid for your merchant/account
YOOKASSA_RECEIPT_MODE=manual
YOOKASSA_VAT_CODE=1
YOOKASSA_PAYMENT_MODE=full_prepayment
YOOKASSA_PAYMENT_SUBJECT=commodity

# Optional Telegram message after a verified successful payment
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local development only. Render sets PORT automatically.
PORT=3000
NODE_ENV=development
